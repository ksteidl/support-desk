# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Nur serverseitig – niemals im Browser verwenden
SUPABASE_SECRET_KEY=sb_secret_xxx

# Claude API (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-xxx

# 32 Byte Schlüssel als Base64 zum Verschlüsseln von Passwörtern & Shopify-Tokens
# Erzeugen mit: openssl rand -base64 32
ENCRYPTION_KEY=

# Schützt /api/cron/sync (z. B. für Vercel Cron)
CRON_SECRET=

# Shopify Admin API Version
SHOPIFY_API_VERSION=2026-07
